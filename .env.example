# 主API平台配置
MAIN_API_KEY=your_main_api_key_here

# 备用API平台配置
BACKUP_API_KEY=your_backup_api_key_here

# 稳定接口API配置（gpt-image-2稳定接口专用）
STABLE_API_KEY=your_stable_api_key_here

# 管理员用户ID（填你自己的 user_xxx，不要用 admin）
ADMIN_USER_ID=your_admin_user_id_here

# 会话签名密钥（随便生成一串 32 位以上的随机字符，例如 openssl rand -hex 32）
# 不设置时临时用 MAIN_API_KEY 派生，改 key 会导致所有人重新登录
SESSION_SECRET=your_session_secret_here
